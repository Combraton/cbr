{
  "format": "combraton-conformance-fixture/1",
  "id": "core.events.older-consumer-is-closed-without-notice",
  "version": 1,
  "title": "A slow subscriber that did not negotiate core.events.backpressure never receives consumer_too_slow and has no backpressure limits declared; its connection is closed and it resumes from its last cursor",
  "requirements": [
    "TRN-4",
    "CMP-7"
  ],
  "spec_refs": [
    "docs/spec/profiles/CORE.md#165-subscriptions",
    "docs/spec/profiles/EXECUTION.md#14-output-telemetry-and-backpressure",
    "docs/decisions/007-execution-test-controls.md"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects",
    "execution.output"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "requires_barriers": [
    "backpressure.limit.reached"
  ],
  "polarity": "negative",
  "kills": [
    "consumer-too-slow-to-older-consumers"
  ],
  "kill_expectations": {
    "consumer-too-slow-to-older-consumers": {
      "step": 8,
      "reason_contains": "params/ended"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "output_spool_bytes": 1024,
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "output": {
                  "repeat": "x",
                  "bytes": 4096
                }
              },
              {
                "runtime_burst": 4000
              }
            ]
          }
        },
        "events": {
          "max_pending_notification_bytes": 65536,
          "backpressure_notice_ms": 1500
        }
      },
      "barriers": []
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "execution.output"
            ],
            "optional_features": []
          }
        ]
      },
      "expect": {
        "ok": {
          "limits": {
            "max_pending_notification_bytes": {
              "$absent": true
            },
            "backpressure_notice_ms": {
              "$absent": true
            }
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "now",
        "limit": 1
      },
      "expect": {
        "ok": {
          "items": []
        }
      },
      "capture": {
        "cursor": "/result/next_cursor"
      },
      "note": "the consumer's last durably processed cursor before subscribing"
    },
    {
      "step": "query",
      "operation": "core.events.subscribe",
      "payload": {
        "cursor": {
          "$var": "cursor"
        }
      },
      "capture": {
        "sub": "/result/subscription"
      }
    },
    {
      "step": "pause_reading",
      "note": "the consumer stops reading"
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "await": false,
      "name": "burst"
    },
    {
      "step": "await_any",
      "signals": [
        "backpressure.limit.reached"
      ],
      "within_ms": 20000
    },
    {
      "step": "resume_reading"
    },
    {
      "step": "collect_until_close",
      "subscription": {
        "$var": "sub"
      },
      "within_ms": 10000,
      "forbid_ended": true,
      "capture_cursor": "cursor"
    },
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "output_spool_bytes": 1024,
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "output": {
                  "repeat": "x",
                  "bytes": 4096
                }
              },
              {
                "runtime_burst": 4000
              }
            ]
          }
        },
        "events": {
          "max_pending_notification_bytes": 65536,
          "backpressure_notice_ms": 1500
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "execution.output"
            ],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "cursor": {
          "$var": "cursor"
        },
        "limit": 1
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-1"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
