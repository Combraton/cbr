{
  "format": "combraton-conformance-fixture/1",
  "id": "core.authentication.launch-authenticated-session-refuses-authenticate",
  "version": 1,
  "title": "A session authenticated by its launch or earlier authentication refuses core.authenticate, before and after negotiation",
