{
  "format": "combraton-conformance-fixture/1",
  "id": "core.events.slow-consumer-is-closed-with-notice-and-resumes",
  "version": 2,
  "title": "A subscriber that stops reading is ended with consumer_too_slow once its pending output exceeds the declared bound, its connection closes, and it resumes from its last cursor with no skipped event while telemetry loss stays declared",
  "requirements": [
    "TRN-4",
    "OBS-7",
    "OBS-1"
  ],
  "spec_refs": [
    "docs/spec/profiles/CORE.md#165-subscriptions",
    "docs/spec/profiles/EXECUTION.md#14-output-telemetry-and-backpressure",
    "docs/decisions/007-execution-test-controls.md"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects",
    "core.events.backpressure",
    "execution.output"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "requires_barriers": [
    "backpressure.limit.reached",
    "backpressure.stall.started"
  ],
  "polarity": "negative",
  "kills": [
    "semantic-events-dropped-under-pressure",
    "unbounded-pending-output",
    "room-wait-unbounded"
  ],
  "kill_expectations": {
    "semantic-events-dropped-under-pressure": {
      "step": 8,
      "reason_contains": "not closed"
    },
    "unbounded-pending-output": {
      "step": 6,
      "reason_contains": "no signal"
    },
    "room-wait-unbounded": {
      "step": 6,
      "reason_contains": "no signal"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "output_spool_bytes": 1024,
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "output": {
                  "repeat": "x",
                  "bytes": 4096
                }
              },
              {
                "runtime_burst": 4000
              }
            ]
          }
        },
        "events": {
          "max_pending_notification_bytes": 65536,
          "backpressure_notice_ms": 1500
        }
      },
      "barriers": []
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects",
              "core.events.backpressure"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "execution.output"
            ],
            "optional_features": []
          }
        ]
      },
      "expect": {
        "ok": {
          "limits": {
            "max_pending_notification_bytes": 65536,
            "backpressure_notice_ms": 1500
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "now",
        "limit": 1
      },
      "expect": {
        "ok": {
          "items": []
        }
      },
      "capture": {
        "cursor": "/result/next_cursor"
      },
      "note": "the consumer's last durably processed cursor before subscribing"
    },
    {
      "step": "query",
      "operation": "core.events.subscribe",
      "payload": {
        "cursor": {
          "$var": "cursor"
        }
      },
      "capture": {
        "sub": "/result/subscription"
      }
    },
    {
      "step": "pause_reading",
      "note": "the consumer stops reading"
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "await": false,
      "name": "burst"
    },
    {
      "step": "await_any",
      "signals": [
        "backpressure.limit.reached"
      ],
      "within_ms": 20000,
      "note": "implementation-specific signal: the consumer made no room within the bound"
    },
    {
      "step": "resume_reading"
    },
    {
      "step": "collect_until_close",
      "subscription": {
        "$var": "sub"
      },
      "within_ms": 10000,
      "expect_last": {
        "items": [],
        "ended": {
          "reason": "consumer_too_slow"
        }
      },
      "capture_cursor": "cursor",
      "capture_next_sequence": "next"
    },
    {
      "step": "expect_signal_gap",
      "from": "backpressure.stall.started",
      "to": "backpressure.limit.reached",
      "min_ms": 1450,
      "max_ms": 2250,
      "note": "room deadline: backpressure_notice_ms from the stall's start"
    },
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "output_spool_bytes": 1024,
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "output": {
                  "repeat": "x",
                  "bytes": 4096
                }
              },
              {
                "runtime_burst": 4000
              }
            ]
          }
        },
        "events": {
          "max_pending_notification_bytes": 65536,
          "backpressure_notice_ms": 1500
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects",
              "core.events.backpressure"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "execution.output"
            ],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "cursor": {
          "$var": "cursor"
        },
        "limit": 1
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "sequence": {
                  "$var": "next"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.output.read",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "end_offset": 4096,
          "coverage": "incomplete",
          "lost_ranges": [
            {
              "from": 0,
              "to": 3072,
              "bytes": 3072,
              "reason": "spool_limit"
            }
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
