{
  "format": "combraton-conformance-fixture/1",
  "id": "composition.packets-are-sealed-at-a-separate-evidence-provider",
  "version": 1,
  "title": "A context provider seals each packet revision at a separately running evidence provider under that provider's grant; the stores stay isolated, the producer is the context provider's own principal, and a packet is never reported before its artifact is sealed",
  "requirements": [
    "CTX-5",
    "EVD-4",
    "SCN-1"
  ],
  "spec_refs": [
    "docs/spec/profiles/CONTEXT.md#1-dependencies-and-negotiation",
    "docs/spec/profiles/CONTEXT.md#5-results-and-packets",
    "docs/spec/profiles/CONTEXT.md#12-conformance-and-test-controls"
  ],
  "role": "provider",
  "binding": "unix",
  "profiles": [
    {
      "name": "context",
      "major": 1
    },
    {
      "name": "evidence",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.grants",
    "context.required_before_start"
  ],
  "requires_controls": [
    "context.script",
    "clock.file"
  ],
  "polarity": "negative",
  "kills": [
    "packet-reported-before-seal"
  ],
  "steps": [
    {
      "step": "start_participant",
      "name": "evd",
      "config": {
        "provider_id": "evidence-1",
        "authority_principals": [
          "owner"
        ],
        "clock": {
          "controlled": "2030-01-01T00:00:00Z"
        }
      },
      "credential_principals": [
        "ctx-service",
        "exec-1",
        "exec-2",
        "caller-1"
      ]
    },
    {
      "step": "start_participant",
      "name": "ctx",
      "config": {
        "provider_id": "context-1",
        "authority_principals": [
          "owner"
        ],
        "clock": {
          "controlled": "2030-01-01T00:00:00Z"
        },
        "context": {
          "scripts": {
            "r-1": [
              {
                "section": {
                  "section_id": "s-1",
                  "item_id": "i-1",
                  "label": "source_inspected",
                  "content": "fn main() {}",
                  "source": {
                    "repository": "repo-a",
                    "path": "src/main.rs",
                    "tree": "tree-1"
                  }
                }
              },
              {
                "publish": {}
              }
            ],
            "r-2": [
              {
                "section": {
                  "section_id": "s-1",
                  "item_id": "i-1",
                  "label": "source_inspected",
                  "content": "fn main() {}",
                  "source": {
                    "repository": "repo-a",
                    "path": "src/main.rs",
                    "tree": "tree-1"
                  }
                }
              },
              {
                "publish": {}
              }
            ]
          },
          "evidence_provider": {
            "provider_id": "evidence-1",
            "socket": {
              "$var": "socket.evd"
            },
            "credential": {
              "$var": "credential.ctx-service"
            },
            "grant": "g-ctx-publish"
          }
        }
      },
      "credential_principals": [
        "exec-1",
        "exec-2",
        "caller-1"
      ]
    },
    {
      "step": "connect",
      "session": "evd-owner",
      "participant": "evd",
      "principal": "owner"
    },
    {
      "step": "negotiate",
      "session": "evd-owner",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.grants"
            ],
            "optional_features": []
          },
          {
            "name": "evidence",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "session": "evd-owner",
      "operation": "core.grant.issue",
      "command_id": "issue-g-ctx-publish",
      "subject": {
        "kind": "core.grant",
        "id": "g-ctx-publish"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "core.grant",
            "id": "g-ctx-publish"
          },
          "revision": 0
        }
      ],
      "payload": {
        "holder": "ctx-service",
        "audience": "evidence-1",
        "rights": [
          "evidence.publish"
        ],
        "resources": [
          {
            "kind": "evidence.artifact",
            "id_prefix": "packet."
          }
        ],
        "delegation": {
          "allowed": false,
          "max_depth": 0
        }
      },
      "expect": {
        "ok": {
          "outcome": {}
        }
      }
    },
    {
      "step": "connect",
      "session": "ctx-owner",
      "participant": "ctx",
      "principal": "owner"
    },
    {
      "step": "negotiate",
      "session": "ctx-owner",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.grants"
            ],
            "optional_features": []
          },
          {
            "name": "context",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": [
              "context.required_before_start",
              "context.advisory"
            ]
          },
          {
            "name": "evidence",
            "majors": [
              1
            ],
            "required": false,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "session": "ctx-owner",
      "operation": "context.request.submit",
      "command_id": "submit-r-1",
      "subject": {
        "kind": "context.request",
        "id": "r-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "context.request",
            "id": "r-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "consumer": {
          "task": "fix the build",
          "principal": "exec-1"
        },
        "basis": {
          "repositories": [
            {
              "id": "repo-a",
              "tree": "tree-1",
              "workspace": "clean",
              "dirty": null
            }
          ],
          "completeness": "complete"
        },
        "items": [
          {
            "item_id": "i-1",
            "selector": {
              "kind": "path",
              "value": "src/main.rs"
            },
            "obligation": "required_before_start",
            "reliance": "binding",
            "selected_by": "owner",
            "check": {
              "kind": "source_included",
              "repository": "repo-a",
              "path": "src/main.rs"
            }
          }
        ],
        "limits": {
          "deadline": "2030-01-01T01:00:00Z",
          "investigation": {
            "units": "queries",
            "amount": 10
          },
          "output_capacity": {
            "units": "bytes",
            "amount": 4096
          }
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "state": "preparing"
          }
        }
      }
    },
    {
      "step": "query",
      "session": "ctx-owner",
      "operation": "context.request.inspect",
      "payload": {
        "request": "r-1"
      },
      "expect": {
        "ok": {
          "state": "ready",
          "packets": [
            {
              "reference": {
                "packet": {
                  "kind": "context.packet",
                  "id": "r-1"
                },
                "revision": 1,
                "artifact": {
                  "provider": "evidence-1",
                  "artifact": {
                    "kind": "evidence.artifact",
                    "id": "packet.r-1.1"
                  },
                  "digest": {
                    "$type": "string"
                  }
                }
              },
              "current": true
            }
          ]
        }
      },
      "capture": {
        "d1": "/result/packets/0/reference/artifact/digest"
      }
    },
    {
      "step": "query",
      "session": "evd-owner",
      "operation": "evidence.inspect",
      "payload": {
        "artifact": {
          "kind": "evidence.artifact",
          "id": "packet.r-1.1"
        }
      },
      "expect": {
        "ok": {
          "state": "sealed",
          "descriptor": {
            "digest": {
              "$var": "d1"
            },
            "media_type": "application/vnd.combraton.context-packet+json",
            "producer": {
              "principal": "ctx-service"
            },
            "source": {
              "kind": "context.packet",
              "id": "r-1"
            }
          }
        }
      }
    },
    {
      "step": "query",
      "session": "evd-owner",
      "operation": "evidence.fetch",
      "payload": {
        "artifact": {
          "kind": "evidence.artifact",
          "id": "packet.r-1.1"
        },
        "digest": {
          "$var": "d1"
        }
      },
      "expect": {
        "ok": {
          "data_base64": {
            "$sha256_base64": {
              "$var": "d1"
            }
          }
        }
      },
      "capture": {
        "bytes": "/result/data_base64"
      }
    },
    {
      "step": "query",
      "session": "ctx-owner",
      "operation": "context.packet.inspect",
      "payload": {
        "packet": "r-1",
        "revision": 1
      },
      "expect": {
        "ok": {
          "excerpt": {
            "offset": 0,
            "data_base64": {
              "$var": "bytes"
            }
          }
        }
      },
      "note": "the excerpt at the context provider is a range of exactly the bytes sealed at the evidence provider"
    },
    {
      "step": "query",
      "session": "ctx-owner",
      "operation": "evidence.inspect",
      "payload": {
        "artifact": {
          "kind": "evidence.artifact",
          "id": "packet.r-1.1"
        }
      },
      "expect": {
        "error": "not_found"
      },
      "note": "isolated stores: the context provider holds no copy of the artifact"
    },
    {
      "step": "kill_participant",
      "name": "evd"
    },
    {
      "step": "command",
      "session": "ctx-owner",
      "operation": "context.request.submit",
      "command_id": "submit-r-2",
      "subject": {
        "kind": "context.request",
        "id": "r-2"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "context.request",
            "id": "r-2"
          },
          "revision": 0
        }
      ],
      "payload": {
        "consumer": {
          "task": "fix the build",
          "principal": "exec-1"
        },
        "basis": {
          "repositories": [
            {
              "id": "repo-a",
              "tree": "tree-1",
              "workspace": "clean",
              "dirty": null
            }
          ],
          "completeness": "complete"
        },
        "items": [
          {
            "item_id": "i-1",
            "selector": {
              "kind": "path",
              "value": "src/main.rs"
            },
            "obligation": "required_before_start",
            "reliance": "binding",
            "selected_by": "owner",
            "check": {
              "kind": "source_included",
              "repository": "repo-a",
              "path": "src/main.rs"
            }
          }
        ],
        "limits": {
          "deadline": "2030-01-01T01:00:00Z",
          "investigation": {
            "units": "queries",
            "amount": 10
          },
          "output_capacity": {
            "units": "bytes",
            "amount": 4096
          }
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "state": "preparing"
          }
        }
      }
    },
    {
      "step": "query",
      "session": "ctx-owner",
      "operation": "context.request.inspect",
      "payload": {
        "request": "r-2"
      },
      "expect": {
        "ok": {
          "state": "preparing",
          "packets": []
        }
      },
      "note": "the evidence provider is down, so the packet cannot be sealed and is not reported"
    },
    {
      "step": "start_participant",
      "name": "evd",
      "config": {
        "provider_id": "evidence-1",
        "authority_principals": [
          "owner"
        ],
        "clock": {
          "controlled": "2030-01-01T00:00:00Z"
        }
      },
      "credential_principals": [
        "ctx-service",
        "exec-1",
        "exec-2",
        "caller-1"
      ]
    },
    {
      "step": "query",
      "session": "ctx-owner",
      "operation": "context.request.inspect",
      "payload": {
        "request": "r-2"
      },
      "expect": {
        "ok": {
          "state": "ready",
          "packets": [
            {
              "reference": {
                "artifact": {
                  "provider": "evidence-1",
                  "artifact": {
                    "kind": "evidence.artifact",
                    "id": "packet.r-2.1"
                  },
                  "digest": {
                    "$type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "capture": {
        "d2": "/result/packets/0/reference/artifact/digest"
      }
    },
    {
      "step": "connect",
      "session": "evd-owner",
      "participant": "evd",
      "principal": "owner"
    },
    {
      "step": "negotiate",
      "session": "evd-owner",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.grants"
            ],
            "optional_features": []
          },
          {
            "name": "evidence",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "query",
      "session": "evd-owner",
      "operation": "evidence.fetch",
      "payload": {
        "artifact": {
          "kind": "evidence.artifact",
          "id": "packet.r-2.1"
        },
        "digest": {
          "$var": "d2"
        }
      },
      "expect": {
        "ok": {
          "data_base64": {
            "$sha256_base64": {
              "$var": "d2"
            }
          }
        }
      }
    },
    {
      "step": "query",
      "session": "evd-owner",
      "operation": "evidence.inspect",
      "payload": {
        "artifact": {
          "kind": "evidence.artifact",
          "id": "packet.r-1.1"
        }
      },
      "expect": {
        "ok": {
          "state": "sealed",
          "descriptor": {
            "digest": {
              "$var": "d1"
            }
          }
        }
      },
      "note": "the evidence provider's own store survived its restart"
    },
    {
      "step": "stop_participant",
      "name": "ctx"
    },
    {
      "step": "stop_participant",
      "name": "evd"
    }
  ]
}
