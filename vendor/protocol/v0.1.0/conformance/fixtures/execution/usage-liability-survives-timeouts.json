{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.usage-liability-survives-timeouts",
  "version": 1,
  "title": "Unknown usage leaves liability unresolved and the budget reserved after the execution deadline, so the exhausted pool refuses more work while unrelated work proceeds; an unenforceable hard ceiling is refused",
