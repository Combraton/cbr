    "EXE-16",
    "SCN-14",
    "EXE-19"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#11-optional-features",
    "docs/spec/profiles/EXECUTION.md#12-usage-and-liability"
