{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.evaluation-is-never-derived-from-exit",
  "version": 2,
  "title": "Exit status zero does not produce an evaluation",
  "requirements": [
    "EXE-5"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#3-status-axes"
  ],
  "role": "provider",
  "profiles": [
