          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      }
    },
    {
      "step": "query",
      "operation": "core.describe",
      "payload": {},
      "await": false,
      "name": "crashing-request",
      "note": "the executor tick at the start of this request reaches the scripted crash"
    },
    {
      "step": "expect_close"
    },
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "scripts": {
            "e-1": [
              {
                "crash": "before_dispatch"
              },
              {
                "stale_dispatch": {
                  "generation": 1
                }
              },
