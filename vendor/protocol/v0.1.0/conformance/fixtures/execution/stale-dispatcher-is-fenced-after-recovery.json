{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.stale-dispatcher-is-fenced-after-recovery",
  "version": 2,
  "title": "After recovery advances the host generation, a dispatcher from the older generation cannot send; the recovered generation delivers once",
  "requirements": [
    "EXE-24",
    "EXE-6"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#71-restart-recovery"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "stale-dispatcher-sends",
    "recovery-host-change-silent"
  ],
  "kill_expectations": {
    "stale-dispatcher-sends": {
      "step": 8,
      "reason_contains": "result/items"
    },
    "recovery-host-change-silent": {
      "step": 8,
      "reason_contains": "result/items"
    }
  },
