      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "cancel-reports-cancelled",
    "idempotent-retry-new-key"
  ],
  "kill_expectations": {
    "cancel-reports-cancelled": {
      "step": 10,
      "reason_contains": "cancellation/outcome"
    },
    "idempotent-retry-new-key": {
      "step": 11,
      "reason_contains": "attempts/1/idempotency_key"
    }
  },
