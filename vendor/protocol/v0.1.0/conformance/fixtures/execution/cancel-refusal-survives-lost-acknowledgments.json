{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.cancel-refusal-survives-lost-acknowledgments",
  "version": 1,
  "title": "A caller that loses the cancel acknowledgment retransmits and gets the same receipt; the harness acknowledgment lost in transit is retried under the same key; the observed refusal is never reported as cancelled",
  "requirements": [
    "SCN-15",
    "EXE-8",
    "EFF-3"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#7-cancellation-and-fencing"
