{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.completion-receipts-resist-conflicts-and-old-attempts",
  "version": 1,
  "title": "A duplicate completion returns the receipt, conflicting content is rejected, and a superseded attempt cannot finalize",
  "requirements": [
    "EXE-6",
    "SCN-3"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#6-completion-receipts"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "last-completion-wins",
    "old-attempt-finalizes"
  ],
  "kill_expectations": {
    "last-completion-wins": {
      "step": 4,
      "reason_contains": "status"
    },
    "old-attempt-finalizes": {
      "step": 4,
      "reason_contains": "result/"
    }
  },
