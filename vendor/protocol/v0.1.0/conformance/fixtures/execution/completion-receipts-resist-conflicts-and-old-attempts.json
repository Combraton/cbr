          "owner"
        ],
        "executor": {
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "host_restart": true
              },
              {
                "complete": {
                  "completion_id": "c-old",
                  "content": "late result",
                  "generation": 1
                }
              },
              {
                "complete": {
                  "completion_id": "c-2",
                  "content": "final result"
                }
              },
              {
                "complete": {
                  "completion_id": "c-2",
                  "content": "final result"
                }
              },
              {
                "complete": {
                  "completion_id": "c-2",
                  "content": "other result"
                }
              }
            ]
          }
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      }
    },
    {
      "step": "describe"
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "result": "returned",
          "finalized_by": "c-2",
          "host": {
            "generation": 2
          },
          "completions": [
            {
              "completion_id": "c-old",
              "generation": 1,
