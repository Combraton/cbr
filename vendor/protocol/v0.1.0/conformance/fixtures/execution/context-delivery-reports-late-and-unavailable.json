{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.context-delivery-reports-late-and-unavailable",
  "version": 1,
  "title": "Context delivery observations carry the exact digest, target and boundary; a packet after its dependent transition is late, an unsupported boundary is unavailable and a lost handoff is unknown",
  "requirements": [
    "EXE-18"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#11-optional-features",
    "docs/spec/profiles/EXECUTION.md#13-context-bindings-and-delivery-observations"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects",
    "execution.context"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "no-late-state"
  ],
  "kill_expectations": {
    "no-late-state": {
      "step": 4,
      "reason_contains": "deliveries/2/outcome"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "adapter": {
            "context_boundaries": [
              "initial_prompt",
              "context_request"
            ]
          },
          "context_packets": [
            {
              "ref": "pkt-1",
              "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
            },
            {
              "ref": "pkt-2",
              "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
            }
          ],
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "context_delivery": {
                  "binding_id": "b-init",
                  "boundary": "initial_prompt",
                  "harness": "acknowledged"
                }
              },
              {
                "context_delivery": {
                  "binding_id": "b-early",
                  "boundary": "context_request",
                  "harness": "accepted"
                }
              },
              {
                "transition": "plan_approved"
              },
              {
                "context_delivery": {
                  "binding_id": "b-late",
                  "boundary": "context_request",
                  "harness": "accepted"
                }
              },
              {
                "context_delivery": {
                  "binding_id": "b-steer",
                  "boundary": "turn_steering",
                  "harness": "accepted"
                }
              },
              {
                "context_delivery": {
                  "binding_id": "b-lost",
                  "boundary": "context_request",
                  "harness": "lost"
                }
              },
              {
                "context_delivery": {
                  "binding_id": "b-queued",
                  "boundary": "context_request",
                  "harness": "queued"
                }
              }
            ]
          }
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "execution.context"
            ],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "context_bindings": [
          {
            "binding_id": "b-init",
            "packet": {
              "ref": "pkt-1",
              "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
            },
            "obligation": "advisory",
            "selected_by": "owner"
          },
          {
            "binding_id": "b-early",
            "packet": {
              "ref": "pkt-2",
              "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
            },
            "obligation": "required_before_transition",
            "selected_by": "owner",
            "transition": "plan_approved"
          },
          {
            "binding_id": "b-late",
            "packet": {
              "ref": "pkt-2",
              "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
            },
            "obligation": "required_before_transition",
            "selected_by": "owner",
            "transition": "plan_approved"
          },
          {
            "binding_id": "b-steer",
            "packet": {
              "ref": "pkt-1",
              "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
            },
            "obligation": "advisory",
            "selected_by": "owner"
          },
          {
            "binding_id": "b-lost",
            "packet": {
              "ref": "pkt-2",
              "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
            },
            "obligation": "advisory",
            "selected_by": "owner"
          },
          {
            "binding_id": "b-queued",
            "packet": {
              "ref": "pkt-1",
              "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
            },
            "obligation": "advisory",
            "selected_by": "owner"
          }
        ]
      }
    },
    {
      "step": "describe"
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "context": {
            "deliveries": [
              {
                "binding_id": "b-init",
                "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
                "target": {
                  "execution": {
                    "kind": "execution.execution",
                    "id": "e-1"
                  }
                },
                "boundary": "initial_prompt",
                "outcome": "acknowledged"
              },
              {
                "binding_id": "b-early",
                "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
                "boundary": "context_request",
                "outcome": "delivered"
              },
              {
                "binding_id": "b-late",
                "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
                "boundary": "context_request",
                "outcome": "late"
              },
              {
                "binding_id": "b-steer",
                "boundary": "turn_steering",
                "outcome": "unavailable"
              },
              {
                "binding_id": "b-lost",
                "outcome": "unknown"
              },
              {
                "binding_id": "b-queued",
                "outcome": "queued"
              }
            ]
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": {
            "$contains": {
              "event": {
                "type": "execution.context.delivery.observed",
                "origin": "provider",
                "payload": {
                  "binding_id": "b-late",
                  "outcome": "late"
                }
              }
            }
          }
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
