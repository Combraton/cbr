{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.internal-error-outcome-is-reconciled-not-repeated",
  "version": 1,
  "title": "An internal_error after a submit leaves its outcome unknown to the caller; reconciling by command ID finds the one execution, and retransmitting replays the original acknowledgment without new work",
  "requirements": [
    "EXE-10",
    "SCN-2",
    "EFF-2",
    "CORE-14",
    "CORE-13"
  ],
  "spec_refs": [
    "docs/spec/profiles/CORE.md#10-command-processing-order",
    "docs/spec/profiles/EXECUTION.md#4-operations-base-profile"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script",
    "store.faults"
  ],
  "polarity": "negative",
  "kills": [
    "internal-error-state-without-binding"
  ],
  "kill_expectations": {
    "internal-error-state-without-binding": {
      "step": 3,
      "reason_contains": "result/deliveries"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "default_script": [
            {
              "deliver": "provider_ack_id"
            }
          ]
        },
        "faults": {
          "response_internal_error": [
            {
              "operation": "execution.submit",
              "times": 1
            }
          ]
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "expect": {
        "error": "internal_error"
      }
    },
    {
      "step": "query",
      "operation": "execution.reconcile",
      "payload": {
        "command_id": "submit-e-1"
      },
      "expect": {
        "ok": {
          "executions": [
            {
              "kind": "execution.execution",
              "id": "e-1"
            }
          ],
          "deliveries": [
            {
              "delivery_id": "e-1.delivery-1"
            }
          ]
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "expect": {
        "ok": {
          "replay": true,
          "acknowledgment": {
            "effect_refs": [
              "e-1.delivery-1"
            ]
          },
          "outcome": {
            "admission": "admitted"
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "deliveries": {
            "$len": 1
          },
          "effects": [
            "e-1.delivery-1"
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
