{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.submit-records-effect-and-links-retries",
  "version": 3,
  "title": "Submit records the delivery effect in its own transaction, writes a dispatch marker before sending, keeps caller correlation, and links a retry to its predecessor",
  "requirements": [
    "EXE-1",
    "EXE-20",
    "EFF-1",
    "EXE-7",
    "CMP-6"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#4-operations-base-profile",
    "docs/spec/profiles/CORE.md#19-effects-and-obligations"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "predecessor-dropped",
    "correlation-dropped"
  ],
  "kill_expectations": {
    "predecessor-dropped": {
      "step": 6,
      "reason_contains": "result/predecessor: missing"
    },
    "correlation-dropped": {
      "step": 3,
      "reason_contains": "result/correlation"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              }
            ],
            "e-2": [
              {
                "deliver": "provider_ack_id"
              }
            ]
          }
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "correlation": {
          "work": "w-9",
          "attempt": 3
        }
      },
      "expect": {
        "ok": {
          "replay": false,
          "acknowledgment": {
            "effect_refs": [
              "e-1.delivery-1"
            ]
          },
          "outcome": {
            "execution": {
              "kind": "execution.execution",
              "id": "e-1"
            },
            "admission": "admitted",
            "delivery_id": "e-1.delivery-1"
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "admission": "admitted",
          "delivery": "acknowledged",
          "evaluation": "not_requested",
          "deliveries": [
            {
              "delivery_id": "e-1.delivery-1",
              "delivery": "acknowledged",
              "proof_class": "provider_ack_id",
              "evidence": {
                "class": "provider_ack_id"
              },
              "history": [
                {
                  "delivery": "pending"
                }
              ]
            }
          ],
          "correlation": {
            "work": "w-9",
            "attempt": 3
          },
          "effects": [
            "e-1.delivery-1"
          ],
          "recovery": []
        }
      }
    },
    {
      "step": "query",
      "operation": "core.effects.get",
      "payload": {
        "effect": "e-1.delivery-1"
      },
      "expect": {
        "ok": {
          "effect": {
            "id": "e-1.delivery-1",
            "kind": "execution.prompt_submission",
            "target": {
              "kind": "execution.execution",
              "id": "e-1"
            },
            "payload_digest": "sha256:abababababababababababababababababababababababababababababababab",
            "retry_class": "non_repeatable"
          },
          "status": "succeeded",
          "observations": [
            {
              "status": "pending",
              "evidence": {
                "class": "recorded_before_dispatch"
              }
            },
            {
              "status": "pending",
              "evidence": {
                "class": "dispatch_intent"
              }
            },
            {
              "status": "succeeded",
              "evidence": {
                "class": "provider_ack_id"
              }
            }
          ]
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-2",
      "subject": {
        "kind": "execution.execution",
        "id": "e-2"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-2"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "predecessor": "e-1"
      },
      "expect": {
        "ok": {
          "outcome": {
            "admission": "admitted"
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-2"
      },
      "expect": {
        "ok": {
          "predecessor": "e-1"
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "sequence": 1,
                "type": "execution.admission.changed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-1"
                },
                "origin": "command",
                "command_id": "submit-e-1"
              }
            },
            {
              "event": {
                "sequence": 2,
                "type": "execution.delivery.observed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-1"
                },
                "origin": "provider",
                "command_id": {
                  "$absent": true
                }
              }
            },
            {
              "event": {
                "sequence": 3,
                "type": "execution.admission.changed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-2"
                }
              }
            },
            {
              "event": {
                "sequence": 4,
                "type": "execution.delivery.observed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-2"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
