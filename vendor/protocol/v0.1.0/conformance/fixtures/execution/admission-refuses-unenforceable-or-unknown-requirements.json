      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "adapter": {
            "enforcement": "cooperative",
            "predicates": [
              {
                "name": "adapter.resume",
                "status": "unknown"
              }
            ]
          }
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "restrictions": [
          {
            "scope": "network",
            "enforcement": "enforced"
          }
        ]
      },
      "expect": {
        "ok": {
          "acknowledgment": {
            "effect_refs": []
          },
          "outcome": {
            "admission": "refused",
            "reason": "enforcement_unavailable",
            "alternative": {
              "$type": "string"
            },
            "delivery_id": {
              "$absent": true
            }
          }
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-2",
      "subject": {
        "kind": "execution.execution",
        "id": "e-2"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-2"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "adapter": {
          "requires": [
            "adapter.resume"
          ]
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "admission": "refused",
            "reason": "capability_unavailable"
          }
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-3",
      "subject": {
        "kind": "execution.execution",
        "id": "e-3"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-3"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "restrictions": [
          {
            "scope": "network",
            "enforcement": "cooperative"
