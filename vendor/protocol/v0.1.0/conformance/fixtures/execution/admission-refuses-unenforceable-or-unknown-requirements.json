                  "runtime": "not_started",
                  "reason": "enforcement_unavailable"
                }
              }
            },
            {
              "event": {
                "type": "execution.admission.changed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-2"
                },
                "payload": {
                  "admission": "refused",
                  "runtime": "not_started"
                }
              }
            },
            {
              "event": {
                "type": "execution.admission.changed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-3"
                },
                "payload": {
                  "admission": "admitted",
                  "runtime": "preparing"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-2"
