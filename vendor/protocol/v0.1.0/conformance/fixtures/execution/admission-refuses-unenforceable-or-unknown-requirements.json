{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.admission-refuses-unenforceable-or-unknown-requirements",
  "version": 3,
  "title": "A required restriction above the adapter's enforcement, or an unknown required predicate, is refused with a reason and an alternative",
  "requirements": [
    "EXE-2",
    "EXE-11"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#5-admission"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "admits-weaker-enforcement",
    "unknown-predicate-supported",
    "unstarted-work-reported-preparing",
    "refusal-records-delivery-effect"
