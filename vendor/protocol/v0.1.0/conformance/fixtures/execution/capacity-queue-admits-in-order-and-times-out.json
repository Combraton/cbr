{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.capacity-queue-admits-in-order-and-times-out",
  "version": 2,
  "title": "Beyond the executor's capacity a submission is queued with a reason and admitted when capacity frees; a queued execution whose queue timeout passes is refused",
  "requirements": [
    "EXE-2",
    "EXE-19"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#5-admission",
    "docs/spec/profiles/EXECUTION.md#8-timeouts"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script",
    "clock.file"
  ],
  "polarity": "negative",
  "kills": [
    "capacity-ignored",
    "unstarted-work-reported-preparing"
  ],
  "kill_expectations": {
    "capacity-ignored": {
      "step": 3,
      "reason_contains": "outcome/admission"
    },
    "unstarted-work-reported-preparing": {
      "step": 5,
      "reason_contains": "result/runtime"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "capacity": 1,
          "default_script": [
            {
              "deliver": "provider_ack_id"
            }
          ],
          "scripts": {
            "e-1": [
              {
                "deliver": "provider_ack_id"
              },
              {
                "runtime": "active"
              },
              {
                "wait_until": "2030-01-01T00:02:00Z"
              },
              {
                "exit": {
                  "code": 0
                }
              }
            ]
          }
        },
        "clock": {
          "controlled": "2030-01-01T00:00:00Z"
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "admission": "admitted"
          }
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-2",
      "subject": {
        "kind": "execution.execution",
        "id": "e-2"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-2"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "admission": "queued",
            "queue_reason": "capacity"
          }
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-3",
      "subject": {
        "kind": "execution.execution",
        "id": "e-3"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-3"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "timeouts": {
          "queue": 60
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "admission": "queued",
            "queue_reason": "capacity"
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-2"
      },
      "expect": {
        "ok": {
          "admission": "queued",
          "queue_reason": "capacity",
          "runtime": "not_started",
          "deliveries": [],
          "effects": []
        }
      }
    },
    {
      "step": "set_clock",
      "instant": "2030-01-01T00:01:00Z"
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-3"
      },
      "expect": {
        "ok": {
          "admission": "refused",
          "reason": "queue_timeout",
          "runtime": "not_started",
          "deliveries": [],
          "effects": []
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-2"
      },
      "expect": {
        "ok": {
          "admission": "queued",
          "runtime": "not_started"
        }
      }
    },
    {
      "step": "set_clock",
      "instant": "2030-01-01T00:02:00Z"
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "runtime": "exited"
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-2"
      },
      "expect": {
        "ok": {
          "admission": "admitted",
          "queue_reason": {
            "$absent": true
          },
          "runtime": "preparing",
          "delivery": "acknowledged",
          "deliveries": [
            {
              "delivery_id": "e-2.delivery-1"
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": {
            "$contains": {
              "event": {
                "type": "execution.admission.changed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-2"
                },
                "origin": "provider",
                "payload": {
                  "admission": "admitted",
                  "runtime": "preparing",
                  "delivery_id": "e-2.delivery-1"
                }
              }
            }
          }
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
