            {
              "event": {
                "type": "execution.delivery.observed"
              }
            },
            {
              "event": {
                "type": "execution.cancel.requested",
                "origin": "command"
              }
            },
            {
              "event": {
                "type": "execution.cancel.observed",
                "origin": "provider",
                "payload": {
                  "outcome": "refused"
                }
              }
            }
          ]
