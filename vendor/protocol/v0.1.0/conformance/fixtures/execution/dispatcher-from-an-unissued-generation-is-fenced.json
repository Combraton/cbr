{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.dispatcher-from-an-unissued-generation-is-fenced",
  "version": 1,
  "title": "A dispatcher naming a host generation the executor never issued is fenced like a stale one, and the current generation delivers once",
  "requirements": [
    "EXE-24",
    "EXE-13"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#71-restart-recovery",
    "docs/spec/profiles/EXECUTION.md#151-conformance-executor-conventions"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "stale-dispatcher-sends"
  ],
  "kill_expectations": {
    "stale-dispatcher-sends": {
      "step": 5,
      "reason_contains": "result/items"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "scripts": {
            "e-1": [
              {
                "stale_dispatch": {
                  "generation": 5
                }
              },
              {
                "deliver": "provider_ack_id"
              }
            ]
          }
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      }
    },
    {
      "step": "describe"
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "delivery": "acknowledged",
          "host": {
            "generation": 1
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "type": "execution.admission.changed"
              }
            },
            {
              "event": {
                "type": "execution.dispatch.fenced",
                "origin": "provider",
                "payload": {
                  "generation": 5,
                  "current_generation": 1
                }
              }
            },
            {
              "event": {
                "type": "execution.delivery.observed",
                "payload": {
                  "delivery": "acknowledged"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
