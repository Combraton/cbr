{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.watch-execution-facts-with-subscriptions",
  "version": 2,
  "title": "Execution facts are ordinary Core events: a subscription filtered to execution subjects receives them in order, and an inspect cursor reads only what happened later",
  "requirements": [
    "EXE-7",
    "OBS-1"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#4-operations-base-profile",
    "docs/spec/profiles/CORE.md#165-subscriptions"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects",
    "core.grants"
  ],
  "requires_controls": [
    "executor.script"
  ],
  "polarity": "negative",
  "kills": [
    "subscription-ignores-kinds"
  ],
  "kill_expectations": {
    "subscription-ignores-kinds": {
      "step": 4,
      "reason_contains": "core.grant"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "default_script": [
            {
              "stall": true
            }
          ]
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects",
              "core.grants"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "query",
      "operation": "core.events.subscribe",
      "payload": {
        "from": "now",
        "kinds": [
          "execution.execution"
        ]
      },
      "capture": {
        "sub": "/result/subscription"
      }
    },
    {
      "step": "command",
      "operation": "core.grant.issue",
      "command_id": "issue-g-1",
      "subject": {
        "kind": "core.grant",
        "id": "g-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "core.grant",
            "id": "g-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "holder": "agent-1",
        "audience": "conformance-provider",
        "rights": [
          "execution.read"
        ],
        "resources": [
          {
            "kind": "execution.execution",
            "id_prefix": "a1-"
          }
        ],
        "delegation": {
          "allowed": false,
          "max_depth": 0
        }
      }
    },
    {
      "step": "expect_no_notification",
      "note": "the grant event is not an execution subject"
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      }
    },
    {
      "step": "expect_notification",
      "within_ms": 2000,
      "expect": {
        "params": {
          "subscription": {
            "$var": "sub"
          },
          "items": [
            {
              "event": {
                "type": "execution.admission.changed",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-1"
                },
                "origin": "command",
                "command_id": "submit-e-1"
              }
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "delivery": "pending"
        }
      },
      "capture": {
        "r": "/result/revision",
        "cursor": "/result/next_cursor"
      }
    },
    {
      "step": "command",
      "operation": "execution.cancel",
      "command_id": "cancel-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": {
            "$var": "r"
          }
        }
      ],
      "payload": {}
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "cursor": {
          "$var": "cursor"
        },
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "type": "execution.cancel.requested",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-1"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "expect_notification",
      "within_ms": 2000,
      "expect": {
        "params": {
          "subscription": {
            "$var": "sub"
          },
          "items": [
            {
              "event": {
                "type": "execution.cancel.requested",
                "subject": {
                  "kind": "execution.execution",
                  "id": "e-1"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
