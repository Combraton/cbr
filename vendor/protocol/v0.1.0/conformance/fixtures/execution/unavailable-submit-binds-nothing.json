{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.unavailable-submit-binds-nothing",
  "version": 1,
  "title": "When the provider cannot commit a submit it answers unavailable: no execution, effect, delivery or event exists, and retransmitting the same command then runs it once",
  "requirements": [
    "EXE-10",
    "EFF-1",
    "SCN-2",
    "CORE-14"
  ],
  "spec_refs": [
    "docs/spec/profiles/CORE.md#10-command-processing-order",
    "docs/spec/profiles/EXECUTION.md#5-admission"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script",
    "store.faults"
  ],
  "polarity": "negative",
  "kills": [
    "unavailable-after-binding"
  ],
  "kill_expectations": {
    "unavailable-after-binding": {
      "step": 3,
      "reason_contains": "expected error not_found"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "default_script": [
            {
              "deliver": "provider_ack_id"
            }
          ]
        },
        "faults": {
          "commit_unavailable": [
            {
              "operation": "execution.submit",
              "times": 1
            }
          ]
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "expect": {
        "error": "unavailable"
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "error": "not_found"
      }
    },
    {
      "step": "query",
      "operation": "core.effects.get",
      "payload": {
        "effect": "e-1.delivery-1"
      },
      "expect": {
        "error": "not_found"
      }
    },
    {
      "step": "query",
      "operation": "execution.reconcile",
      "payload": {
        "command_id": "submit-e-1"
      },
      "expect": {
        "ok": {
          "executions": [],
          "deliveries": []
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": []
        }
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        }
      },
      "expect": {
        "ok": {
          "replay": false,
          "outcome": {
            "admission": "admitted",
            "delivery_id": "e-1.delivery-1"
          }
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "delivery": "acknowledged",
          "deliveries": {
            "$len": 1
          },
          "effects": [
            "e-1.delivery-1"
          ]
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
