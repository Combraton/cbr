{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.retries-follow-retry-class",
  "version": 1,
  "title": "After attempts with unknown outcomes, a non-repeatable submission is never retried, an idempotent cancellation is retried only with the same key, and a read probe is retried",
