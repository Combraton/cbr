{
  "format": "combraton-conformance-fixture/1",
  "id": "socket.subscription-recheck-race-regression",
  "version": 1,
  "title": "A revoke and put committed while an idle re-check is paused are never delivered to the revoked subscriber",
  "requirements": [
    "OBS-9",
    "REL-13",
    "TRN-3"
  ],
  "spec_refs": [
    "docs/spec/profiles/CORE.md#165-subscriptions",
