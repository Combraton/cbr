{
  "format": "combraton-conformance-fixture/1",
  "id": "socket.idle-obligation-overdue-without-traffic",
  "version": 1,
  "title": "An obligation deadline passing while every session is idle is reported by a provider-origin event without any request",
  "requirements": [
    "EFF-4",
    "EXE-19",
    "EXE-7"
  ],
  "spec_refs": [
    "docs/spec/profiles/CORE.md#194-obligations",
    "docs/spec/profiles/EXECUTION.md#8-timeouts"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "binding": "unix",
  "requires_controls": [
    "executor.script",
    "clock.file"
  ],
  "polarity": "negative",
  "kills": [
    "executor-ticks-only-on-requests",
    "clock-file-ignored"
  ],
  "kill_expectations": {
    "executor-ticks-only-on-requests": {
      "step": 6,
      "reason_contains": "no frame within"
    },
    "clock-file-ignored": {
      "step": 6,
      "reason_contains": "no frame within"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "scripts": {
            "e-1": [
              {
                "deliver": "bytes_written"
              }
            ]
          }
        },
        "clock": {
          "controlled": "2030-01-01T00:00:00Z"
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "query",
      "operation": "core.events.subscribe",
      "payload": {
        "from": "now",
        "kinds": [
          "execution.execution"
        ]
      },
      "capture": {
        "sub": "/result/subscription"
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "timeouts": {
          "delivery": 60
        }
      }
    },
    {
      "step": "expect_notification",
      "within_ms": 2000,
      "expect": {
        "params": {
          "subscription": {
            "$var": "sub"
          },
          "items": [
            {
              "event": {
                "type": "execution.admission.changed"
              }
            },
            {
              "event": {
                "type": "execution.delivery.observed",
                "payload": {
                  "delivery": "pending",
                  "proof_class": "bytes_written"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "set_clock",
      "instant": "2030-01-01T00:01:00Z",
      "note": "no session sends anything after this"
    },
    {
      "step": "expect_notification",
      "within_ms": 2000,
      "expect": {
        "params": {
          "subscription": {
            "$var": "sub"
          },
          "items": [
            {
              "event": {
                "type": "execution.timeout.passed",
                "origin": "provider",
                "payload": {
                  "timeout": "delivery"
                }
              }
            },
            {
              "event": {
                "type": "core.effect.obligation.overdue",
                "origin": "provider",
                "payload": {
                  "effect": "e-1.delivery-1",
                  "obligation": "e-1.delivery-1.evidence"
                }
              }
            },
            {
              "event": {
                "type": "execution.delivery.observed",
                "origin": "provider",
                "payload": {
                  "delivery": "ambiguous"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "expect_no_notification"
    },
    {
      "step": "stop"
    }
  ]
}
