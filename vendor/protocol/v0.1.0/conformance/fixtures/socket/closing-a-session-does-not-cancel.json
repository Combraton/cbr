{
  "format": "combraton-conformance-fixture/1",
  "id": "socket.closing-a-session-does-not-cancel",
  "version": 1,
  "title": "Closing the socket session that submitted an execution leaves it running for every other session",
  "requirements": [
    "EXE-22"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#4-operations-base-profile",
    "docs/decisions/007-execution-test-controls.md"
