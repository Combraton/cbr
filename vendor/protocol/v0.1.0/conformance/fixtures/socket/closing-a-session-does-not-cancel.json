            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "connect",
      "session": "a"
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
