  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "binding": "unix",
  "requires_controls": [
    "executor.script"
  ],
  "requires_barriers": [
    "session.closed"
  ],
  "polarity": "negative",
  "kills": [
