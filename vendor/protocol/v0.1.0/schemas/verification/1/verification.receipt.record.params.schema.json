{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/verification/1/verification.receipt.record.params.schema.json",
  "title": "verification.receipt.record params",
  "allOf": [
    {
      "$ref": "../../core/1/command.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "verification.receipt.record"
    },
    "payload": {
      "type": "object",
      "required": [
        "subjects",
        "contract",
        "evaluator",
        "environment",
        "inputs",
        "properties",
        "observed_from",
        "observed_until",
        "valid_until",
        "scope",
        "provenance"
      ],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/subject_entry"
          }
        },
        "contract": {
          "$ref": "common.schema.json#/$defs/evidence_reference"
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/environment"
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_reference"
          }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "common.schema.json#/$defs/property_result"
          }
        },
        "observed_from": {
          "$ref": "../../core/1/common.schema.json#/$defs/instant"
        },
        "observed_until": {
          "$ref": "../../core/1/common.schema.json#/$defs/instant"
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../core/1/common.schema.json#/$defs/instant"
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "provenance": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "$ref": "../../core/1/common.schema.json#/$defs/subject"
              },
              {
                "$ref": "common.schema.json#/$defs/evidence_reference"
              }
            ]
          }
        },
        "evaluator": {
          "$ref": "common.schema.json#/$defs/evaluator"
        }
      },
      "unevaluatedProperties": false
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/receipt_subject"
    },
    "preconditions": {
      "minItems": 1,
      "maxItems": 1
    }
  },
  "unevaluatedProperties": false
}
