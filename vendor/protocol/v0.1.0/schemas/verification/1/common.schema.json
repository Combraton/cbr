{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/verification/1/common.schema.json",
  "title": "verification/1 common definitions",
  "$defs": {
    "job_subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "verification.job"
        },
        "id": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        }
      },
      "unevaluatedProperties": false
    },
    "receipt_subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "verification.receipt"
        },
        "id": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        }
      },
      "unevaluatedProperties": false
    },
    "evidence_reference": {
      "allOf": [
        {
          "$ref": "../../evidence/1/common.schema.json#/$defs/reference"
        }
      ],
      "required": [
        "provider"
      ]
    },
    "receipt_reference": {
      "type": "object",
      "required": [
        "provider",
        "receipt",
        "artifact"
      ],
      "properties": {
        "provider": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "receipt": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "artifact": {
          "$ref": "common.schema.json#/$defs/evidence_reference"
        }
      },
      "unevaluatedProperties": false
    },
    "subject_entry": {
      "type": "object",
      "required": [
        "role",
        "digest"
      ],
      "properties": {
        "role": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject": {
          "$ref": "../../core/1/common.schema.json#/$defs/subject"
        }
      },
      "unevaluatedProperties": false
    },
    "subject_digest": {
      "type": "object",
      "required": [
        "role",
        "digest"
      ],
      "properties": {
        "role": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "unevaluatedProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "anchors"
      ],
      "properties": {
        "anchors": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "unevaluatedProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$"
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated",
        "indeterminate"
      ]
    },
    "property_result": {
      "type": "object",
      "required": [
        "property_id",
        "result",
        "evidence"
      ],
      "properties": {
        "property_id": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "result": {
          "$ref": "common.schema.json#/$defs/result"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_reference"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "receipt_content": {
      "type": "object",
      "required": [
        "format",
        "receipt",
        "subjects",
        "contract",
        "evaluator",
        "environment",
        "inputs",
        "properties",
        "observed_from",
        "observed_until",
        "valid_until",
        "scope",
        "job",
        "provenance"
      ],
      "properties": {
        "format": {
          "const": "combraton-verification-receipt/1"
        },
        "receipt": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/subject_entry"
          }
        },
        "contract": {
          "$ref": "common.schema.json#/$defs/evidence_reference"
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/environment"
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_reference"
          }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "common.schema.json#/$defs/property_result"
          }
        },
        "observed_from": {
          "$ref": "../../core/1/common.schema.json#/$defs/instant"
        },
        "observed_until": {
          "$ref": "../../core/1/common.schema.json#/$defs/instant"
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../core/1/common.schema.json#/$defs/instant"
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "provenance": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "$ref": "../../core/1/common.schema.json#/$defs/subject"
              },
              {
                "$ref": "common.schema.json#/$defs/evidence_reference"
              }
            ]
          }
        },
        "evaluator": {
          "type": "object",
          "required": [
            "id",
            "version",
            "principal"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "principal": {
              "$ref": "../../core/1/common.schema.json#/$defs/principal"
            }
          },
          "unevaluatedProperties": false
        },
        "job": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../core/1/common.schema.json#/$defs/identifier"
            }
          ]
        }
      },
      "unevaluatedProperties": false
    }
  }
}
