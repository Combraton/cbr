{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/verification/1/verification.receipt.record.result.schema.json",
  "title": "verification.receipt.record result",
  "type": "object",
  "required": [
    "acknowledgment",
    "outcome",
    "replay"
  ],
  "properties": {
    "acknowledgment": {
      "$ref": "../../core/1/common.schema.json#/$defs/acknowledgment"
    },
    "replay": {
      "type": "boolean"
    },
    "outcome": {
      "type": "object",
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "$ref": "common.schema.json#/$defs/receipt_reference"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
