{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/knowledge/1/knowledge.conflict.open.params.schema.json",
  "title": "knowledge.conflict.open params",
  "allOf": [
    {
      "$ref": "../../core/1/command.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "knowledge.conflict.open"
    },
    "payload": {
      "type": "object",
      "required": [
        "revisions"
      ],
      "properties": {
        "revisions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "common.schema.json#/$defs/claim_reference"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "unevaluatedProperties": false
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/conflict_subject"
    },
    "preconditions": {
      "minItems": 1,
      "maxItems": 1
    }
  },
  "unevaluatedProperties": false
}
