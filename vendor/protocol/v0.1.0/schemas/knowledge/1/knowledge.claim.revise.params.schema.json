{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/knowledge/1/knowledge.claim.revise.params.schema.json",
  "title": "knowledge.claim.revise params",
  "allOf": [
    {
      "$ref": "../../core/1/command.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "knowledge.claim.revise"
    },
    "payload": {
      "type": "object",
      "required": [
        "plane",
        "statement",
        "scope",
        "support",
        "derivation",
        "supersedes"
      ],
      "properties": {
        "plane": {
          "$ref": "common.schema.json#/$defs/plane"
        },
        "statement": {
          "$ref": "common.schema.json#/$defs/statement"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/scope"
        },
        "validity": {
          "$ref": "common.schema.json#/$defs/validity"
        },
        "basis": {
          "$ref": "common.schema.json#/$defs/basis"
        },
        "support": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/support_entry"
          }
        },
        "derivation": {
          "$ref": "common.schema.json#/$defs/derivation"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/claim_reference"
          }
        },
        "conditions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/condition"
          }
        },
        "health": {
          "$ref": "common.schema.json#/$defs/health"
        },
        "supersedes": {
          "type": "object",
          "required": [
            "revision",
            "digest"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "../../core/1/common.schema.json#/$defs/digest"
            }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/claim_subject"
    },
    "preconditions": {
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "properties": {
          "revision": {
            "minimum": 1
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
