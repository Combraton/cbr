{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/knowledge/1/knowledge.decision.record.params.schema.json",
  "title": "knowledge.decision.record params",
  "allOf": [
    {
      "$ref": "../../core/1/command.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "knowledge.decision.record"
    },
    "payload": {
      "type": "object",
      "required": [
        "claim",
        "decision",
        "validation_basis",
        "rationale"
      ],
      "properties": {
        "claim": {
          "$ref": "common.schema.json#/$defs/claim_reference"
        },
        "decision": {
          "enum": [
            "accepted_for_use",
            "rejected",
            "superseded"
          ]
        },
        "permitted_use": {
          "$ref": "common.schema.json#/$defs/permitted_use"
        },
        "supersedes_decision": {
          "$ref": "../../core/1/common.schema.json#/$defs/identifier"
        },
        "validation_basis": {
          "type": "object",
          "required": [
            "evidence",
            "receipts"
          ],
          "properties": {
            "evidence": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "common.schema.json#/$defs/evidence_reference"
              }
            },
            "receipts": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "common.schema.json#/$defs/receipt_reference"
              }
            },
            "target": {
              "$ref": "common.schema.json#/$defs/basis"
            }
          },
          "unevaluatedProperties": false
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "unevaluatedProperties": false,
      "if": {
        "properties": {
          "decision": {
            "const": "accepted_for_use"
          }
        }
      },
      "then": {
        "required": [
          "permitted_use"
        ]
      },
      "else": {
        "not": {
          "required": [
            "permitted_use"
          ]
        }
      }
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/decision_subject"
    },
    "preconditions": {
      "minItems": 1,
      "maxItems": 1
    }
  },
  "unevaluatedProperties": false
}
