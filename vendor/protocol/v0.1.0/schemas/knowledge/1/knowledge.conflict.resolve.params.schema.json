{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/knowledge/1/knowledge.conflict.resolve.params.schema.json",
  "title": "knowledge.conflict.resolve params",
  "allOf": [
    {
      "$ref": "../../core/1/command.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "knowledge.conflict.resolve"
    },
    "payload": {
      "type": "object",
      "required": [
        "resolution",
        "rationale"
      ],
      "properties": {
        "resolution": {
          "$ref": "common.schema.json#/$defs/resolution"
        },
        "selected": {
          "$ref": "common.schema.json#/$defs/claim_reference"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "unevaluatedProperties": false
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/conflict_subject"
    },
    "preconditions": {
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "properties": {
          "revision": {
            "minimum": 1
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
