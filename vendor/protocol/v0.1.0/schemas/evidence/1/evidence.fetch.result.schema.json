{
  "type": "object",
  "required": [
    "artifact",
    "digest",
    "availability",
    "offset",
    "data_base64",
    "next_offset",
    "size"
  ],
  "properties": {
    "artifact": {
      "$ref": "common.schema.json#/$defs/artifact_subject"
    },
    "digest": {
      "$ref": "../../core/1/common.schema.json#/$defs/digest"
    },
    "availability": {
      "$ref": "common.schema.json#/$defs/availability"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "data_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "next_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "unevaluatedProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.fetch.result.schema.json",
  "title": "evidence.fetch result"
}
