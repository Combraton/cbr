{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.fetch.params.schema.json",
  "title": "evidence.fetch params",
  "allOf": [
    {
      "$ref": "../../core/1/query.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "evidence.fetch"
    },
    "payload": {
      "type": "object",
      "required": [
        "artifact",
        "digest"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.schema.json#/$defs/artifact_subject"
        },
        "digest": {
          "$ref": "../../core/1/common.schema.json#/$defs/digest"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
