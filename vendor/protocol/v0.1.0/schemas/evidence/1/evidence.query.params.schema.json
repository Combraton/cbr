{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.query.params.schema.json",
  "title": "evidence.query params",
  "allOf": [
    {
      "$ref": "../../core/1/query.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "evidence.query"
    },
    "payload": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "producer_principal": {
              "$ref": "../../core/1/common.schema.json#/$defs/principal"
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "digest": {
              "$ref": "../../core/1/common.schema.json#/$defs/digest"
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source": {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "unevaluatedProperties": false
            },
            "work": {
              "$ref": "../../core/1/common.schema.json#/$defs/subject"
            }
          },
          "unevaluatedProperties": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
