{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.upload.prepare.result.schema.json",
  "title": "evidence.upload.prepare result",
  "type": "object",
  "required": [
    "acknowledgment",
    "outcome",
    "replay"
  ],
  "properties": {
    "acknowledgment": {
      "$ref": "../../core/1/common.schema.json#/$defs/acknowledgment"
    },
    "replay": {
      "type": "boolean"
    },
    "outcome": {
      "type": "object",
      "required": [
        "artifact",
        "state",
        "received",
        "chunk_limit",
        "chunk_overhead_bytes"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.schema.json#/$defs/artifact_subject"
        },
        "state": {
          "const": "staged"
        },
        "received": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunk_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunk_overhead_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
