{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.purge.result.schema.json",
  "title": "evidence.purge result",
  "type": "object",
  "required": [
    "acknowledgment",
    "outcome",
    "replay"
  ],
  "properties": {
    "acknowledgment": {
      "$ref": "../../core/1/common.schema.json#/$defs/acknowledgment"
    },
    "replay": {
      "type": "boolean"
    },
    "outcome": {
      "type": "object",
      "required": [
        "artifact",
        "availability",
        "released_holds"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.schema.json#/$defs/artifact_subject"
        },
        "availability": {
          "enum": [
            "purge_pending",
            "purged"
          ]
        },
        "released_holds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/hold_subject"
          }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
