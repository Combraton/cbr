{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.release.result.schema.json",
  "title": "evidence.release result",
  "type": "object",
  "required": [
    "acknowledgment",
    "outcome",
    "replay"
  ],
  "properties": {
    "acknowledgment": {
      "$ref": "../../core/1/common.schema.json#/$defs/acknowledgment"
    },
    "replay": {
      "type": "boolean"
    },
    "outcome": {
      "type": "object",
      "required": [
        "hold",
        "state"
      ],
      "properties": {
        "hold": {
          "$ref": "common.schema.json#/$defs/hold_subject"
        },
        "state": {
          "const": "released"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
