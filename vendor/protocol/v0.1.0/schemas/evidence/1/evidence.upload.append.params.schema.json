{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.upload.append.params.schema.json",
  "title": "evidence.upload.append params",
  "allOf": [
    {
      "$ref": "../../core/1/command.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "evidence.upload.append"
    },
    "payload": {
      "type": "object",
      "required": [
        "offset",
        "data_base64"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "unevaluatedProperties": false
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/artifact_subject"
    },
    "preconditions": {
      "minItems": 1,
      "maxItems": 1
    }
  },
  "unevaluatedProperties": false
}
