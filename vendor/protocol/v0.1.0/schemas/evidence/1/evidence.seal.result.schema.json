{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/evidence/1/evidence.seal.result.schema.json",
  "title": "evidence.seal result",
  "type": "object",
  "required": [
    "acknowledgment",
    "outcome",
    "replay"
  ],
  "properties": {
    "acknowledgment": {
      "$ref": "../../core/1/common.schema.json#/$defs/acknowledgment"
    },
    "replay": {
      "type": "boolean"
    },
    "outcome": {
      "type": "object",
      "required": [
        "artifact",
        "state",
        "digest",
        "size",
        "already_sealed"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.schema.json#/$defs/artifact_subject"
        },
        "state": {
          "const": "sealed"
        },
        "digest": {
          "$ref": "../../core/1/common.schema.json#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "already_sealed": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
